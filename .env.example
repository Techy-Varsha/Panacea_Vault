# Panacea Vault Environment Variables
# Copy this file to .env and fill in your values

# Database
# Format: mysql+pymysql://username:password@host:port/database
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/panacea_vault

# Security
# Generate a secure secret key: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars

# JWT Algorithm
ALGORITHM=HS256

# Access token expiry in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# DSA Engine Configuration
KNAPSACK_CURRENCY_SCALE=10000
WAITING_TIME_BOOST=5
EMERGENCY_RESERVE_PERCENT=15.0
MAX_URGENCY_SCORE=100

# Environment
ENVIRONMENT=development
DEBUG=true

# Dataset Path (for seeding)
DATASET_PATH=D:/Panacea_Vault/dataset

# MySQL Config (alternative to DATABASE_URL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=password
DB_NAME=panacea_vault